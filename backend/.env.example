# Network configuration for local development.
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# SQLite is the local quick-start option. For PostgreSQL, use an uncommitted
# value such as: postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DATABASE_URL=sqlite:///./data/app.db
