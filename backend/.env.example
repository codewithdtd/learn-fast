# Network configuration for local development.
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# SQLite is the local quick-start option. For PostgreSQL, use an uncommitted
# value such as: postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DATABASE_URL=sqlite:///./data/app.db

# 9Router Local AI Configuration
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your-9router-api-key
AI_MODEL=Anti_2
AI_REQUEST_TIMEOUT=90.0

# Speaking transcription (audio is sent from backend to Google Gemini after consent)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_ASR_MODEL=gemini-3.5-transcribe
SPEAKING_DAILY_AI_QUOTA=5
SPEAKING_MAX_AUDIO_BYTES=20971520
SPEAKING_PROVIDER_TIMEOUT=150.0
SPEAKING_GRADING_TIMEOUT=90.0
SPEAKING_TIMEZONE=Asia/Bangkok

# YTranscript: 50 free units/month; caption transcripts cost 1 unit, Whisper fallback may cost 15.
YTRANSCRIPT_API_KEY=
YTRANSCRIPT_API_URL=https://ytranscript.com/api/v1/transcript
VIDEO_PRACTICE_PROVIDER_TIMEOUT=20.0
VIDEO_PRACTICE_REQUESTS_PER_MINUTE=30
VIDEO_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
VIDEO_TRANSLATION_API_URL=https://api.mymemory.translated.net/get

